{
  "version": 2,
  "sourceRoot": "src",
  "publicEntry": "src/index.ts",
  "publicApiFiles": [
    "src/index.ts",
    "src/application/index.ts"
  ],
  "privatePublicTargets": [
    "src/application/ports",
    "src/adapters",
    "src/composition",
    "src/domain",
    "src/maintenance",
    "src/schema"
  ],
  "forbiddenImportFragments": [
    "spikes/adr-behavior"
  ],
  "requiredFiles": [
    "src/index.ts",
    "src/domain/index.ts",
    "src/domain/reducer.ts",
    "src/application/index.ts",
    "src/application/runtime-context.ts",
    "src/application/use-case.ts",
    "src/application/write-service.ts",
    "src/application/ports/journal-commit-port.ts",
    "src/application/ports/runtime-provider.ts",
    "src/adapters/sqlite/index.ts",
    "src/adapters/mcp/index.ts",
    "src/adapters/mcp/json-schema-contract.ts",
    "src/adapters/runtime/index.ts",
    "src/adapters/runtime/node-runtime-provider.ts",
    "src/maintenance/index.ts",
    "src/composition/index.ts",
    "src/schema/index.ts",
    "src/schema/json-schema.ts"
  ],
  "atomicWritePort": {
    "file": "src/application/ports/journal-commit-port.ts",
    "interface": "JournalCommitPort",
    "method": "appendAndProject"
  },
  "layers": [
    {
      "name": "domain",
      "root": "src/domain",
      "mayImport": ["domain"],
      "externalPackages": [],
      "forbiddenIdentifiers": [
        "Date",
        "Temporal",
        "fetch",
        "globalThis",
        "process",
        "performance",
        "crypto",
        "WebSocket",
        "EventSource",
        "navigator",
        "Bun",
        "Deno",
        "setTimeout",
        "setInterval"
      ],
      "forbiddenMemberAccess": ["Math.random"]
    },
    {
      "name": "schema",
      "root": "src/schema",
      "mayImport": ["schema"],
      "externalPackages": ["json-schema-to-ts"]
    },
    {
      "name": "application",
      "root": "src/application",
      "mayImport": ["application", "domain", "schema"],
      "externalPackages": []
    },
    {
      "name": "sqlite-adapter",
      "root": "src/adapters/sqlite",
      "mayImport": ["sqlite-adapter", "application", "domain"],
      "externalPackages": ["better-sqlite3"]
    },
    {
      "name": "mcp-adapter",
      "root": "src/adapters/mcp",
      "mayImport": ["mcp-adapter", "application", "schema"],
      "externalPackages": ["@modelcontextprotocol/server"]
    },
    {
      "name": "runtime-adapter",
      "root": "src/adapters/runtime",
      "mayImport": ["runtime-adapter", "application"],
      "externalPackages": ["node:"]
    },
    {
      "name": "maintenance",
      "root": "src/maintenance",
      "mayImport": ["maintenance", "application"],
      "externalPackages": ["node:"]
    },
    {
      "name": "composition",
      "root": "src/composition",
      "mayImport": [
        "composition",
        "application",
        "domain",
        "sqlite-adapter",
        "mcp-adapter",
        "runtime-adapter",
        "maintenance",
        "schema"
      ],
      "externalPackages": [
        "@modelcontextprotocol/server",
        "better-sqlite3",
        "node:"
      ]
    }
  ],
  "publicEntryRule": {
    "mayImport": ["application"],
    "externalPackages": []
  }
}
